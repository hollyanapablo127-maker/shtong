SHTONG_ENVIRONMENT=development
SHTONG_DEV_MODE=true
SHTONG_WEB_ORIGINS=http://localhost:5173,http://localhost:5174
# Inject the following only in a local shell or secret store. Never commit values.
SHTONG_BOOTSTRAP_SECRET=
SHTONG_BOOTSTRAP_ADMIN_ONE_LOGIN=
SHTONG_BOOTSTRAP_ADMIN_ONE_PASSWORD=
SHTONG_BOOTSTRAP_ADMIN_TWO_LOGIN=
SHTONG_BOOTSTRAP_ADMIN_TWO_PASSWORD=
SHTONG_COOKIE_SECURE=false
# Compose and production: inject every secret through the deployment secret store.
SHTONG_DATABASE_NAME=shtong
SHTONG_DATABASE_URL=jdbc:postgresql://localhost:5432/shtong
SHTONG_DATABASE_USER=shtong_app
SHTONG_DATABASE_PASSWORD=
SHTONG_MIGRATION_DATABASE_USER=shtong_migration
SHTONG_MIGRATION_DATABASE_PASSWORD=
SHTONG_REFRESH_TOKEN_PEPPER=
SHTONG_STATE_ENCRYPTION_KEY=
SHTONG_SSO_ADAPTER_ID=medical-insurance
# Replace in every non-development environment. Never expose this value to clients.
SHTONG_SSO_ADAPTER_SECRET=replace-with-a-long-random-adapter-secret
SHTONG_MEDICAL_INSURANCE_ENTRY_URL=/medical-insurance/sso/callback/
SHTONG_MINIO_ROOT_USER=
SHTONG_MINIO_ROOT_PASSWORD=
